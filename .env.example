# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (dev database and the one used by integration tests)
DATABASE_URL=postgresql://xstore:xstore@localhost:5432/xstore
DATABASE_URL_TEST=postgresql://xstore:xstore@localhost:5432/xstore_test

# Redis (db 0 for dev, db 1 for integration tests)
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# MinIO (S3-compatible storage; dev and production compose)
MINIO_ROOT_USER=xstore
MINIO_ROOT_PASSWORD=xstore-dev-secret

# S3 access for api and worker. S3_ENDPOINT is used from the server; S3_PUBLIC_URL is the origin
# browsers and iPhones reach (presigned URLs and public media links; production
# https://dl.xstorex.ru). Integration tests use buckets under S3_BUCKET_PREFIX_TEST.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=xstore
S3_SECRET_KEY=xstore-dev-secret
S3_BUCKET_PREFIX=xstore-
S3_BUCKET_PREFIX_TEST=xstore-test-

# API
API_PORT=3001
LOG_LEVEL=info
# Where the web server reaches the API (server-side rendering and the /api rewrite). Production
# compose sets http://api:3001 itself.
API_INTERNAL_URL=http://localhost:3001

# Public site URL
SITE_URL=http://localhost:3000

# Payments (api and worker). `fake` is for development and tests only: payments live in Redis and
# are paid from /dev/pay/<id>; the API refuses to start with it when NODE_ENV=production.
# Production compose sets PAYMENT_PROVIDER=platega itself. FAKE_PAYMENT_WEBHOOK_SECRET signs fake
# webhooks (HMAC-SHA256, at least 16 characters).
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=dev-fake-webhook-secret
# Development-only routes and pages (fake payment buttons). Never set in production.
# XSTORE_DEV_PAGES=1

# Mail (api and worker): SMTP_URL is smtp://host:port or smtps://user:password@host:465, MAIL_FROM the
# sender. Both are required with NODE_ENV=production; in development they default to the local
# Mailpit from `pnpm infra:up` (letters at http://127.0.0.1:8025). Tests use SMTP_URL_TEST and
# MAILPIT_API_URL (defaults: smtp://127.0.0.1:1025, http://127.0.0.1:8025).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Xstore <noreply@xstorex.ru>"

# Connecting an iPhone (api). ENROLL_CERT_PATH / ENROLL_KEY_PATH: PEM certificate (full chain
# allowed) and private key that sign the connection profile; both or neither. Production uses
# Caddy's certificate for SITE_DOMAIN (the compose file sets these paths itself, see
# CADDY_CERT_ISSUER below; re-read when Caddy renews it). For development run
# `pnpm --filter @xstore/api enroll:dev-cert`: it writes a self-signed pair to .secrets/enroll/
# (gitignored); use absolute paths. ENROLL_TEST_ANCHOR_PATH: an extra PEM root trusted for answers
# of test devices besides Apple Root CA; refused when NODE_ENV=production. E2E uses both from
# .secrets/enroll/ by itself after `enroll:dev-cert` and `enroll:test-ca`. A real iOS answer
# (outside git): IOS_REAL_FIXTURE=<path> pnpm --filter @xstore/api exec vitest run device-response.real
# ENROLL_CERT_PATH=/absolute/path/to/xstorexWEB/.secrets/enroll/cert.pem
# ENROLL_KEY_PATH=/absolute/path/to/xstorexWEB/.secrets/enroll/key.pem
# ENROLL_TEST_ANCHOR_PATH=

# Worker. TMP_DIR holds downloaded IPAs during inspection (up to 10 GB each); default: OS temp.
WORKER_CONCURRENCY=4
# TMP_DIR=

# Production compose (infra/docker-compose.yml). Local values only: on the server set the
# real domains and strong POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD. POSTGRES_PASSWORD goes into
# DATABASE_URL unescaped, so keep it to letters and digits. Compose sets DATABASE_URL,
# REDIS_URL and SITE_URL inside the containers from service names and SITE_DOMAIN.
SITE_DOMAIN=localhost
DL_DOMAIN=dl.localhost
# Folder of Caddy's certificate store (caddydata: caddy/certificates/<issuer>/<SITE_DOMAIN>/) whose
# certificate signs the iPhone connection file: `local` for localhost. On the server remove it
# (default: Let's Encrypt, acme-v02.api.letsencrypt.org-directory) or set acme.zerossl.com-v2-dv90
# if Caddy got the certificate from ZeroSSL.
CADDY_CERT_ISSUER=local
POSTGRES_PASSWORD=xstore
# Footer Telegram link, baked into the web image at build time (optional).
# NEXT_PUBLIC_TELEGRAM_URL=
