# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (dev database and the one used by integration tests)
DATABASE_URL=postgresql://xstore:xstore@localhost:5432/xstore
DATABASE_URL_TEST=postgresql://xstore:xstore@localhost:5432/xstore_test

# Redis (db 0 for dev, db 1 for integration tests)
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# MinIO (S3-compatible storage; dev and production compose)
MINIO_ROOT_USER=xstore
MINIO_ROOT_PASSWORD=xstore-dev-secret

# API
API_PORT=3001
LOG_LEVEL=info

# Public site URL
SITE_URL=http://localhost:3000

# Worker
WORKER_CONCURRENCY=4

# Production compose (infra/docker-compose.yml). Local values only: on the server set the
# real domains and strong POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD. POSTGRES_PASSWORD goes into
# DATABASE_URL unescaped, so keep it to letters and digits. Compose sets DATABASE_URL,
# REDIS_URL and SITE_URL inside the containers from service names and SITE_DOMAIN.
SITE_DOMAIN=localhost
DL_DOMAIN=dl.localhost
API_INTERNAL_URL=http://api:3001
POSTGRES_PASSWORD=xstore
# Footer Telegram link, baked into the web image at build time (optional).
# NEXT_PUBLIC_TELEGRAM_URL=
