# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (dev database and the one used by integration tests)
DATABASE_URL=postgresql://xstore:xstore@localhost:5432/xstore
DATABASE_URL_TEST=postgresql://xstore:xstore@localhost:5432/xstore_test

# Redis (db 0 for dev, db 1 for integration tests)
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# MinIO (S3-compatible storage; dev and production compose)
MINIO_ROOT_USER=xstore
MINIO_ROOT_PASSWORD=xstore-dev-secret

# S3 access for api and worker. S3_ENDPOINT is used from the server; S3_PUBLIC_URL is the origin
# browsers and iPhones reach (presigned URLs and public media links; production
# https://dl.xstorex.ru). Integration tests use buckets under S3_BUCKET_PREFIX_TEST.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=xstore
S3_SECRET_KEY=xstore-dev-secret
S3_BUCKET_PREFIX=xstore-
S3_BUCKET_PREFIX_TEST=xstore-test-

# API
API_PORT=3001
LOG_LEVEL=info

# Public site URL
SITE_URL=http://localhost:3000
# Paths are relative to the repository root; production compose uses the Caddy certificate.
ENROLL_CERT_PATH=infra/dev-certs/enroll.crt
ENROLL_KEY_PATH=infra/dev-certs/enroll.key

# Worker. TMP_DIR holds downloaded IPAs during inspection (up to 10 GB each); default: OS temp.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Xstore <noreply@xstorex.ru>"
# Test-only Mailpit HTTP API.
MAILPIT_API=http://localhost:8025

WORKER_CONCURRENCY=4
# TMP_DIR=

# Production compose (infra/docker-compose.yml). Local values only: on the server set the
# real domains and strong POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD. POSTGRES_PASSWORD goes into
# DATABASE_URL unescaped, so keep it to letters and digits. Compose sets DATABASE_URL,
# REDIS_URL and SITE_URL inside the containers from service names and SITE_DOMAIN.
SITE_DOMAIN=localhost
DL_DOMAIN=dl.localhost
API_INTERNAL_URL=http://api:3001
POSTGRES_PASSWORD=xstore
# Footer Telegram link, baked into the web image at build time (optional).
# NEXT_PUBLIC_TELEGRAM_URL=
