# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (dev database and the one used by integration tests)
DATABASE_URL=postgresql://xstore:xstore@localhost:5432/xstore
DATABASE_URL_TEST=postgresql://xstore:xstore@localhost:5432/xstore_test

# Redis (db 0 for dev, db 1 for integration tests)
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# MinIO (S3-compatible storage, dev only)
MINIO_ROOT_USER=xstore
MINIO_ROOT_PASSWORD=xstore-dev-secret

# API
API_PORT=3001
LOG_LEVEL=info

# Public site URL
SITE_URL=http://localhost:3000
