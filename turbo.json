{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@xstore/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_TELEGRAM_URL"]
    },
    "@xstore/db#generate": {
      "outputs": ["src/generated/**"]
    },
    "@xstore/db#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@xstore/db#typecheck": {
      "dependsOn": ["^build", "generate", "build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "REDIS_URL",
        "REDIS_URL_TEST",
        "S3_ENDPOINT",
        "S3_PUBLIC_URL",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET_PREFIX",
        "S3_BUCKET_PREFIX_TEST"
      ]
    },
    "@xstore/db#test:int": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "REDIS_URL",
        "REDIS_URL_TEST",
        "S3_ENDPOINT",
        "S3_PUBLIC_URL",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET_PREFIX",
        "S3_BUCKET_PREFIX_TEST"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@xstore/web#test:e2e": {
      "dependsOn": ["^build", "@xstore/api#build", "@xstore/db#build", "@xstore/worker#build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL_TEST",
        "REDIS_URL_TEST",
        "S3_ENDPOINT",
        "S3_PUBLIC_URL",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET_PREFIX_TEST"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["XSTORE_DEV_PAGES"]
    }
  }
}
