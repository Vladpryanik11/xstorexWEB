generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum Role {
  user
  support
  admin
}

enum SessionKind {
  user
  staff
}

enum DeviceStatus {
  new
  pending
  processing
  active
  blocked
  expired
}

enum EnrollmentStatus {
  pending
  completed
  failed
  expired
}

model User {
  id                         String              @id @default(cuid())
  email                      String?             @unique
  isProvisional              Boolean             @default(false)
  checkoutEmail              String?
  role                       Role                @default(user)
  passwordHash               String?
  totpSecret                 String?
  blockedAt                  DateTime?
  createdAt                  DateTime            @default(now())
  sessions                   Session[]
  uploads                    IpaUpload[]
  devices                    Device[]
  enrollmentSessions         EnrollmentSession[]
  subscriptions              Subscription[]
  orders                     Order[]
  uploadedDeviceCertificates DeviceCertificate[]
  loginHandoffs              LoginHandoff[]
  signingJobs                SigningJob[]
  installTokens              InstallToken[]

  @@index([isProvisional, checkoutEmail])
}

model Session {
  /// sha256 hex of the cookie token; the token itself is never stored.
  id                 String              @id
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               SessionKind
  deviceId           String?
  device             Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  ip                 String?
  userAgent          String?
  createdAt          DateTime            @default(now())
  lastSeenAt         DateTime            @default(now())
  enrollmentSessions EnrollmentSession[]

  @@index([userId])
  @@index([deviceId])
}

model Device {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  udid               String              @unique
  product            String
  iosVersion         String
  name               String
  status             DeviceStatus        @default(new)
  appleAccountId     String?
  registeredAt       DateTime?
  createdAt          DateTime            @default(now())
  sessions           Session[]
  enrollmentSessions EnrollmentSession[]
  installEvents      InstallEvent[]
  subscription       Subscription?
  certificates       DeviceCertificate[]
  signingJobs        SigningJob[]
  installTokens      InstallToken[]

  @@index([userId, createdAt])
  @@index([status])
}

enum DeviceCertificateStatus {
  active
  replaced
  revoked
  expired
  deleted
}

/// Supplier files for one device: `.p12` and its password encrypted with the master key
/// (`@xstore/secrets`), the `.mobileprovision` as is. At most one `active` row per device
/// (partial unique index `device_certificate_one_active` in the migration).
model DeviceCertificate {
  id               String                  @id @default(cuid())
  deviceId         String
  device           Device                  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status           DeviceCertificateStatus @default(active)
  /// Never select outside `apps/api/src/apple` and the worker.
  p12Enc           String
  /// Never select outside `apps/api/src/apple` and the worker.
  p12PasswordEnc   String
  profile          Bytes
  profileUuid      String
  teamId           String
  appIdPattern     String
  certSerial       String
  certSha1         String
  certNotAfter     DateTime
  profileExpiresAt DateTime
  uploadedById     String
  uploadedBy       User                    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now())
  endedAt          DateTime?
  signingJobs      SigningJob[]
  signedBuilds     SignedBuild[]

  @@index([certSha1, status])
  @@index([deviceId, createdAt])
  @@index([status])
}

model EnrollmentSession {
  /// sha256 hex of the one-time nonce; the nonce itself is never stored.
  nonce     String           @id
  status    EnrollmentStatus @default(pending)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  next      String?
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([deviceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum UploadPurpose {
  catalog
  signer
}

enum UploadStatus {
  uploading
  uploaded
  inspecting
  ready
  rejected
  expired
}

/// A multipart upload straight to S3 (admin catalog uploads in M1, Signer uploads in M6).
model IpaUpload {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose      UploadPurpose
  bucket       String
  key          String
  /// S3 multipart upload id; null until the multipart upload is created.
  s3UploadId   String?
  fileName     String
  sizeBytes    BigInt
  partSize     Int
  status       UploadStatus  @default(uploading)
  rejectCode   String?
  /// Result of `ipa:inspect`.
  inspect      Json?
  appVersionId String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ownerId])
  @@index([status])
}

enum AppStatus {
  draft
  published
  hidden
}

enum VersionStatus {
  draft
  published
  rejected
}

enum CollectionLayout {
  grid3
  icons
  screenshots
  banner
}

enum CollectionSource {
  manual
  top_downloads
  trending
  top_rated
  recently_updated
}

/// A catalog app. Only `published` apps are visible outside `/admin`.
/// Migration `m1_catalog` adds a GIN trigram index on `lower(name)` for search.
model App {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  subtitle            String?
  description         String?
  developer           String?
  categoryId          String?
  category            Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  iconKey             String?
  screenshotKeys      String[]
  /// Hero carousel image.
  bannerKey           String?
  removedFromAppStore Boolean          @default(false)
  /// «Основание для распространения»; required before publishing.
  rightsBasis         String?
  /// `free` or `addon:<Plan.code>`.
  accessLevel         String           @default("free")
  status              AppStatus        @default(draft)
  hiddenReason        String?
  /// Filled in by the admin (no iTunes import, owner decision 2026-11-05).
  rating              Float?
  ratingCount         Int?
  languages           String[]
  itunesId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  versions            AppVersion[]
  collectionItems     CollectionItem[]
  installEvents       InstallEvent[]

  @@index([status])
  @@index([categoryId])
}

model AppVersion {
  id            String         @id @default(cuid())
  appId         String
  app           App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  version       String
  build         String
  bundleId      String
  minIos        String?
  /// `UIDeviceFamily` from the IPA: 1 iPhone, 2 iPad.
  deviceFamily  Int[]          @default([1])
  sizeBytes     BigInt
  sha256        String
  ipaKey        String
  icon57Key     String?
  encrypted     Boolean
  changelog     String?
  status        VersionStatus  @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  signingJobs   SigningJob[]
  signedBuilds  SignedBuild[]
  installTokens InstallToken[]

  @@unique([bundleId, version, build])
  @@index([bundleId])
  @@index([appId, publishedAt])
}

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String
  icon String
  sort Int
  apps App[]

  @@index([sort])
}

model Collection {
  id     String           @id @default(cuid())
  slug   String           @unique
  title  String
  layout CollectionLayout
  source CollectionSource
  sort   Int
  limit  Int              @default(12)
  onHome Boolean          @default(true)
  items  CollectionItem[]

  @@index([sort])
}

model CollectionItem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  appId        String
  app          App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  position     Int
  pinned       Boolean    @default(false)

  @@id([collectionId, appId])
  @@index([appId])
}

/// One install from the catalog; feeds «Популярное» and «Набирают популярность».
model InstallEvent {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------------------------
// N1: subscriptions and payments. CHECK constraints live in the n1_billing migration SQL.

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  durationDays Int
  /// Whole rubles, > 0 (CHECK).
  priceRub     Int
  active       Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Subscription {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?       @unique
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  autoRenew    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  entitlements Entitlement[]

  @@index([userId])
}

enum OrderStatus {
  created
  pending
  paid
  failed
  expired
  refunded
}

model Order {
  id                String       @id @default(cuid())
  userId            String
  /// Restrict: financial records never disappear with a user or subscription.
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  planId            String
  plan              Plan         @relation(fields: [planId], references: [id])
  planSnapshot      Json
  checkoutEmail     String
  checkoutKey       String       @unique
  returnTo          String?
  amountRub         Int
  status            OrderStatus
  provider          String
  providerPaymentId String?      @unique
  redirectUrl       String?
  paidAt            DateTime?
  expiresAt         DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  entitlement       Entitlement?

  @@index([status, createdAt])
}

model Entitlement {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planCode       String
  durationDays   Int
  startsAt       DateTime
  expiresAt      DateTime
  orderId        String?      @unique
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  grantedById    String?
  note           String?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, expiresAt])
}

model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  eventKey    String    @unique
  payload     Json
  result      String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Spec v2 §4 step 2a: a one-time link that carries a buyer's sign-in into Safari.
model LoginHandoff {
  id        String    @id @default(cuid())
  /// sha256 hex of the token; the token itself is never stored.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model EmailCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  template  String
  to        String
  subject   String
  /// sending | sent | failed. `sending` is the claim taken before the SMTP call.
  status    String
  error     String?
  /// Set for letters sent at most once (`payment_paid:<orderId>`); null for repeatable ones.
  dedupeKey String?  @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------------------------
// N4: signing and OTA install (spec 2026-11-21-n4-signing-install-design.md).

enum SigningStage {
  queued
  downloading
  signing
  uploading
  ready
  failed
}

/// One «Установить» tap that needed a signed build. Taps for the same version × device files
/// share one queue job (`queueJobId` = `sign-<appVersionId>-<deviceCertificateId>`).
model SigningJob {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId            String
  device              Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  appVersionId        String
  appVersion          AppVersion        @relation(fields: [appVersionId], references: [id], onDelete: Cascade)
  deviceCertificateId String
  deviceCertificate   DeviceCertificate @relation(fields: [deviceCertificateId], references: [id], onDelete: Cascade)
  queueJobId          String
  stage               SigningStage      @default(queued)
  errorCode           String?
  /// Why it failed or waits, for the admin only: DISK_FULL, ZSIGN_TIMEOUT, ZSIGN_EXIT, ERROR.
  failReason          String?
  signedBuildId       String?
  signedBuild         SignedBuild?      @relation(fields: [signedBuildId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  finishedAt          DateTime?

  @@index([queueJobId, stage])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/// An IPA signed with one device's supplier files; lives in the `signed` bucket at `key`.
model SignedBuild {
  id                  String            @id @default(cuid())
  appVersionId        String
  appVersion          AppVersion        @relation(fields: [appVersionId], references: [id], onDelete: Cascade)
  deviceCertificateId String
  deviceCertificate   DeviceCertificate @relation(fields: [deviceCertificateId], references: [id], onDelete: Cascade)
  key                 String
  sizeBytes           BigInt
  /// The bundle id the build was signed with (the profile's App ID for a single-app profile).
  bundleId            String
  createdAt           DateTime          @default(now())
  lastUsedAt          DateTime          @default(now())
  signingJobs         SigningJob[]
  installTokens       InstallToken[]

  @@unique([appVersionId, deviceCertificateId])
  @@index([lastUsedAt])
  @@index([deviceCertificateId])
}

/// One-time OTA install link; only the SHA-256 of the token is stored.
model InstallToken {
  tokenHash     String      @id
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  signedBuildId String
  signedBuild   SignedBuild @relation(fields: [signedBuildId], references: [id], onDelete: Cascade)
  appVersionId  String
  appVersion    AppVersion  @relation(fields: [appVersionId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usedAt        DateTime?
  usedIp        String?
  usedUa        String?
  createdAt     DateTime    @default(now())

  @@index([signedBuildId, expiresAt])
  @@index([expiresAt])
}
