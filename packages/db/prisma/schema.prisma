generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum Role {
  user
  support
  admin
}

enum SessionKind {
  user
  staff
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  role         Role      @default(user)
  passwordHash String?
  totpSecret   String?
  blockedAt    DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  uploads      IpaUpload[]
}

model Session {
  /// sha256 hex of the cookie token; the token itself is never stored.
  id         String      @id
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       SessionKind
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum UploadPurpose {
  catalog
  signer
}

enum UploadStatus {
  uploading
  uploaded
  inspecting
  ready
  rejected
  expired
}

/// A multipart upload straight to S3 (admin catalog uploads in M1, Signer uploads in M6).
model IpaUpload {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  purpose      UploadPurpose
  bucket       String
  key          String
  /// S3 multipart upload id; null until the multipart upload is created.
  s3UploadId   String?
  fileName     String
  sizeBytes    BigInt
  partSize     Int
  status       UploadStatus  @default(uploading)
  rejectCode   String?
  /// Result of `ipa:inspect`.
  inspect      Json?
  appVersionId String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ownerId])
  @@index([status])
}
