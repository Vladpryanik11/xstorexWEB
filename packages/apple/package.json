  "dependencies": {
    "jose": "6.2.15",
    "node-forge": "1.4.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
