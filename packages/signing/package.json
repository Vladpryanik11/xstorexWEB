{
  "name": "@xstore/signing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "browser": null,
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    },
    "./testing": {
      "browser": null,
      "types": "./dist/testing.d.ts",
      "node": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "asn1js": "3.1.0",
    "node-forge": "1.4.3",
    "pkijs": "3.4.3",
    "plist": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/plist": "3.0.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
