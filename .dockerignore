# Build context is the repo root; images rebuild everything from source.
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/playwright-report
**/test-results
**/*.tsbuildinfo
packages/db/src/generated

# Secrets and local state never enter an image.
**/.env
**/.env.*
!**/.env.example
**/*.p8
**/*.p12
**/*.pem
# Public Apple Root CA that verifies iPhone answers; must come after **/*.pem.
!apps/api/src/enrollment/apple-root-ca.pem
**/*.key
**/*.mobileprovision
.secrets

# Not needed to build any image.
.git
.claude
.superpowers
docs
infra
