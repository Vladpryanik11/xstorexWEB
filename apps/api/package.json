    "dev:certs": "node scripts/dev-certs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@node-rs/argon2": "2.2.2",
    "@xstore/db": "workspace:*",
    "@xstore/shared": "workspace:*",
    "asn1js": "3.1.0",
    "bullmq": "6.5.4",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "otpauth": "9.5.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pkijs": "3.4.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
