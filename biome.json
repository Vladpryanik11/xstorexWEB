{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.next", "!**/generated", "!**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@xstore/secrets/decrypt": "Расшифровка секретов только в модуле apps/api/src/apple и воркере."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@xstore/billing": "Пакет оплаты только для API и воркера: сайт его не импортирует.",
                  "@xstore/mail": "Пакет писем только для API и воркера: сайт его не импортирует.",
                  "@xstore/mail/testing": "Пакет писем только для API и воркера: сайт его не импортирует.",
                  "@xstore/secrets/decrypt": "Расшифровка секретов только в модуле apps/api/src/apple и воркере.",
                  "@xstore/secrets": "Пакет секретов только для API и воркера: сайт его не импортирует.",
                  "@xstore/signing": "Пакет подписи только для API и воркера: сайт его не импортирует."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/apple/**", "apps/worker/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
